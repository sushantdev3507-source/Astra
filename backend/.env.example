# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
ASTRA_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- AI provider selection ---
# Which AI Edit provider is active. Valid values: mock | gemini | real
# (real = Replicate/FLUX.1 Fill). Defaults to mock if unset -- Astra
# works fully with zero AI configuration, using deterministic mock
# transforms instead of a real model.
AI_PROVIDER=mock

# --- Gemini provider (AI_PROVIDER=gemini) ---
# Required only if AI_PROVIDER=gemini. Get a key from Google AI Studio.
# NEVER commit a real value here -- this file is a template only.
ASTRA_GEMINI_API_KEY=
# Optional -- defaults to gemini-3.1-flash-image (Google's current
# image generation/editing model) if unset.
# ASTRA_GEMINI_MODEL=gemini-3.1-flash-image

# --- Replicate provider (AI_PROVIDER=real) ---
# Required only if AI_PROVIDER=real.
ASTRA_REPLICATE_API_TOKEN=
# Optional -- defaults to FLUX.1 Fill if unset.
# ASTRA_REPLICATE_MODEL_VERSION=black-forest-labs/flux-fill-dev

# --- Async job processing (optional) ---
# Set to true (and run a Celery worker) for real async AI job
# processing. Defaults to false -- jobs run synchronously in-process,
# which works with zero setup but blocks the request while running.
ASTRA_USE_CELERY_JOBS=false
ASTRA_REDIS_URL=redis://localhost:6379/0

# --- Authentication (placeholder implementation) ---
# Accounts currently live in-memory on the backend (see
# backend/app/services/auth/repository.py) -- lost on every restart.
# This is a deliberate, discussed placeholder until a real database is
# confirmed with the team, not a bug.
#
# MUST be set to a real random value (32+ bytes) before any deployment
# beyond local development -- anyone who knows this can forge a valid
# login for any account. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Left unset here on purpose; the backend uses an obviously-fake
# default and logs a loud warning at startup if this isn't set.
ASTRA_JWT_SECRET=
# Optional -- session token lifetime in hours. Defaults to 168 (7 days).
# ASTRA_JWT_EXPIRY_HOURS=168

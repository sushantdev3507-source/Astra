# ── Backend (astra/backend/.env) ────────────────────────────────────
# Environment name. Informational only in Sprint 1.
ASTRA_ENV=development

# Comma-separated list of origins allowed to call the backend (CORS).
# Add your Sonamai frontend's origin here when integrating later.
CORS_ORIGINS=http://localhost:3000


# ── Frontend (astra/frontend/.env.local) ────────────────────────────
# Base URL of the Astra backend API. The frontend never hard-codes
# localhost in code -- this is the single source of truth.
NEXT_PUBLIC_API_URL=http://localhost:8000
